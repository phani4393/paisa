# Paisa - Environment Variables
# Copy this file to .env and fill in your Plaid credentials.
#   cp .env.example .env   (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# Get your keys from the Plaid Dashboard: https://dashboard.plaid.com/developers/keys

# Your Plaid client ID
PLAID_CLIENT_ID=your_client_id_here

# Your Plaid secret (use the one matching PLAID_ENV below)
PLAID_SECRET=your_secret_here

# Plaid environment: sandbox | development | production
# - sandbox: test credentials, fake banks (use username "user_good" / password "pass_good")
# - production: real bank connections
PLAID_ENV=sandbox
